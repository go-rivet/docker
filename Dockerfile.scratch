ARG GO_VERSION=1.26

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS checkout
RUN apk add --no-cache git
ARG RIVET_VERSION=main
WORKDIR /build
RUN git clone --depth 1 --branch "${RIVET_VERSION}" https://github.com/go-rivet/rivet.git .

FROM scratch AS source
COPY --from=checkout /build/ /

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS builder
RUN apk add --no-cache curl git xz
ARG BUILDARCH
RUN set -eu; \
    case "${BUILDARCH}" in \
      amd64) zig_arch=x86_64-linux; zig_sha=24aeeec8af16c381934a6cd7d95c807a8cb2cf7df9fa40d359aa884195c4716c ;; \
      arm64) zig_arch=aarch64-linux; zig_sha=f7a654acc967864f7a050ddacfaa778c7504a0eca8d2b678839c21eea47c992b ;; \
      *) echo "Unsupported build architecture: ${BUILDARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSLo /tmp/zig.tar.xz "https://ziglang.org/download/0.14.1/zig-${zig_arch}-0.14.1.tar.xz"; \
    echo "${zig_sha}  /tmp/zig.tar.xz" | sha256sum -c -; \
    mkdir -p /opt/zig; \
    tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1; \
    ln -s /opt/zig/zig /usr/local/bin/zig; \
    rm /tmp/zig.tar.xz

ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
WORKDIR /build
COPY --from=source / /build/
COPY build-rivet.sh /usr/local/bin/build-rivet
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/.cache/zig \
    sh /usr/local/bin/build-rivet && mkdir -p /scratch/tmp && chmod 1777 /scratch/tmp

FROM scratch AS runtime
COPY --from=builder /build/rivet /rivet
COPY --from=builder /scratch/ /
ENTRYPOINT ["/rivet"]

FROM runtime AS verify
COPY test-lua.yml /workspace/Taskfile.yml
WORKDIR /workspace
USER 12345:12345
RUN ["/rivet"]

FROM gcr.io/distroless/static-debian12:nonroot AS distroless
COPY --from=builder /build/rivet /rivet
COPY --from=builder --chown=65532:65532 /scratch/tmp /workspace
WORKDIR /workspace
ENTRYPOINT ["/rivet"]

FROM distroless AS distroless-verify
COPY test-lua.yml /workspace/Taskfile.yml
RUN ["/rivet"]
RUN ["/rivet", "--yes", "--taskfile", "https://raw.githubusercontent.com/go-rivet/rivet/a22891eeebba5b2b8df10aff643f3f3b90e9504d/pkg/rivet/testdata/includes_remote/first/second/Taskfile.yml", "--list-all"]

FROM runtime AS final
